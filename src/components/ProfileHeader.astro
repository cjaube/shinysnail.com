---
import { Image } from 'astro:assets';

interface Props {
  avatarSrc: string;
  name: string;
  handle: string;
  bio: string;
}

const { avatarSrc, name, handle, bio } = Astro.props;
---

<div class='text-center'>
  <div class='relative inline-block mb-2 animate-float'>
    <div class='relative p-1 bg-linear-to-r from-primary via-accent to-secondary'>
      <Image
        src={avatarSrc}
        alt={name}
        width={112}
        height={112}
        class='w-28 h-28 object-cover'
        loading='eager'
        decoding='async'
      />
    </div>
  </div>

  <h1 class='font-display text-3xl md:text-4xl font-bold mb-1'>
    <span class='gradient-text'>{name}</span>
  </h1>
  <p class='text-muted-foreground text-lg mb-4'>{handle}</p>
  <p class='text-foreground/80 max-w-md mx-auto leading-relaxed'>
    {bio}
  </p>
</div>
